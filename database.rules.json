{
  "rules": {
    "lobbies": {
      ".read": false,
      ".write": false
    },
    "v5": {
      "index": {
        ".read": "auth != null",
        "$code": {
          ".write": "auth != null && (!data.exists() || data.child('owner').val() === auth.uid || data.child('maj').val() < now - 20000)",
          ".validate": "$code.matches(/^[0-9]{4}$/) && newData.hasChildren(['owner', 'maj', 'version'])",
          "owner": {
            ".validate": "newData.isString()"
          },
          "hote": {
            ".validate": "newData.isString() && newData.val().length <= 30"
          },
          "nb": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 8"
          },
          "prive": {
            ".validate": "newData.isBoolean()"
          },
          "visible": {
            ".validate": "newData.isBoolean()"
          },
          "status": {
            ".validate": "newData.isString()"
          },
          "version": {
            ".validate": "newData.isString()"
          },
          "maj": {
            ".validate": "newData.isNumber() && newData.val() <= now"
          },
          "$autre": {
            ".validate": false
          }
        }
      },
      "lobbies": {
        "$cle": {
          ".read": "auth != null",
          ".write": "auth != null && ((!data.exists() && newData.child('settings/host_id').val() === auth.uid) || data.child('settings/host_id').val() === auth.uid || (!newData.exists() && !data.child('players').exists()))",
          "settings": {
            ".validate": "newData.hasChildren(['essais', 'min', 'max', 'rounds', 'host_id', 'timer', 'version'])",
            "host_id": {
              ".write": "auth != null && newData.val() === auth.uid && data.parent().parent().child('players/' + auth.uid).exists() && (!data.parent().parent().child('players/' + data.val()).exists() || data.parent().parent().child('players/' + data.val() + '/last_seen').val() < now - 15000)",
              ".validate": "newData.isString()"
            }
          },
          "players": {
            "$uid": {
              ".write": "auth != null && ((auth.uid === $uid && (!newData.exists() || data.parent().parent().child('settings').exists())) || (!newData.exists() && data.child('last_seen').val() < now - 25000))",
              ".validate": "newData.hasChildren(['name', 'score'])",
              "name": {
                ".validate": "newData.isString() && newData.val().length <= 30"
              },
              "score": {
                ".validate": "newData.isNumber()"
              },
              "frappe": {
                ".validate": "newData.isString() && newData.val().length <= 12"
              },
              "theme": {
                "$k": {
                  ".validate": "newData.isString() && newData.val().length <= 9"
                }
              }
            }
          },
          "match_data": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid"
            }
          },
          "fini_states": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid",
              ".validate": "newData.isBoolean()"
            }
          },
          "round_wins": {
            "$round": {
              "$uid": {
                ".write": "auth != null && auth.uid === $uid"
              }
            }
          },
          "status": {
            ".validate": "newData.isString()"
          }
        }
      }
    },
    "v7": {
      "index": {
        ".read": "auth != null",
        "$code": {
          ".write": "auth != null && (!data.exists() || data.child('owner').val() === auth.uid || data.child('maj').val() < now - 20000 || root.child('v7/lobbies/' + $code + '/settings/host_id').val() === auth.uid || (!newData.exists() && !root.child('v7/lobbies/' + $code).exists()))",
          ".validate": "$code.matches(/^[0-9]{4}$/) && newData.hasChildren(['owner', 'maj', 'version'])",
          "owner": {
            ".validate": "newData.isString()"
          },
          "hote": {
            ".validate": "newData.isString() && newData.val().length <= 30"
          },
          "nb": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 8"
          },
          "prive": {
            ".validate": "newData.isBoolean()"
          },
          "visible": {
            ".validate": "newData.isBoolean()"
          },
          "status": {
            ".validate": "newData.isString()"
          },
          "version": {
            ".validate": "newData.isString()"
          },
          "maj": {
            ".validate": "newData.isNumber() && newData.val() <= now"
          },
          "$autre": {
            ".validate": false
          }
        }
      },
      "secrets": {
        "$code": {
          ".write": "auth != null && $code.matches(/^[0-9]{4}$/) && (!root.child('v7/lobbies/' + $code).exists() || root.child('v7/lobbies/' + $code + '/settings/host_id').val() === auth.uid)",
          ".validate": "newData.isString() && newData.val().length <= 64"
        }
      },
      "comptes": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['maj', 'donnees'])",
          "maj": {
            ".validate": "newData.isNumber() && newData.val() <= now + 5000"
          },
          "donnees": {
            ".validate": "newData.isString() && newData.val().length <= 500000"
          }
        }
      },
      "horloge": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isNumber() && newData.val() <= now + 5000"
        }
      },
      "pieges": {
        "$code": {
          ".write": "auth != null && !newData.exists() && !root.child('v7/lobbies/' + $code).exists()",
          "$id": {
            "$cible": {
              ".read": "auth != null && ((auth.uid !== $cible && root.child('v7/lobbies/' + $code + '/settings/piege_de/' + auth.uid).exists()) || root.child('v7/lobbies/' + $code + '/spectateurs/' + auth.uid).exists())",
              ".write": "auth != null && !data.exists() && auth.uid !== $cible && $id === root.child('v7/lobbies/' + $code + '/settings/piege_id').val() && (auth.uid === root.child('v7/lobbies/' + $code + '/settings/piege_de/' + $cible).val() || (root.child('v7/lobbies/' + $code + '/settings/piege_de/' + auth.uid).exists() && now > root.child('v7/lobbies/' + $code + '/settings/piege_fin_choix').val()))",
              ".validate": "newData.hasChildren(['mot', 'de']) && newData.child('mot').val().length >= root.child('v7/lobbies/' + $code + '/settings/min').val() && newData.child('mot').val().length <= root.child('v7/lobbies/' + $code + '/settings/max').val()",
              "mot": {
                ".validate": "newData.isString() && newData.val().matches(/^[A-Z]+$/)"
              },
              "de": {
                ".validate": "newData.isString()"
              },
              "auto": {
                ".validate": "newData.isBoolean()"
              },
              "$autre": {
                ".validate": false
              }
            }
          }
        }
      },
      "lobbies": {
        "$code": {
          ".read": "auth != null && (data.child('players/' + auth.uid).exists() || data.child('spectateurs/' + auth.uid).exists())",
          ".write": "auth != null && $code.matches(/^[0-9]{4}$/) && ((!data.exists() && newData.child('settings/host_id').val() === auth.uid && newData.child('players/' + auth.uid).exists()) || data.child('settings/host_id').val() === auth.uid || (!newData.exists() && (!data.child('players').exists() || data.child('maj').val() < now - 1800000)))",
          "maj": {
            ".write": "auth != null && data.parent().child('players/' + auth.uid).exists()",
            ".validate": "newData.isNumber() && newData.val() <= now"
          },
          "settings": {
            ".validate": "newData.hasChildren(['essais', 'min', 'max', 'rounds', 'host_id', 'timer', 'version'])",
            "host_id": {
              ".write": "auth != null && newData.val() === auth.uid && data.parent().parent().child('players/' + auth.uid).exists() && (!data.parent().parent().child('players/' + data.val()).exists() || data.parent().parent().child('players/' + data.val() + '/last_seen').val() < now - 15000)",
              ".validate": "newData.isString()"
            },
            "piege_de": {
              "$cible": {
                ".validate": "newData.isString() && newData.val() !== $cible"
              }
            }
          },
          "players": {
            "$uid": {
              ".write": "auth != null && ((auth.uid === $uid && (data.exists() || !newData.exists() || (data.parent().parent().child('settings').exists() && (!root.child('v7/secrets/' + $code).exists() || newData.child('preuve').val() === root.child('v7/secrets/' + $code).val())))) || (!newData.exists() && data.child('last_seen').val() < now - 25000))",
              ".validate": "newData.hasChildren(['name', 'score'])",
              "name": {
                ".validate": "newData.isString() && newData.val().length <= 30"
              },
              "score": {
                ".validate": "newData.isNumber()"
              },
              "frappe": {
                ".validate": "newData.isString() && newData.val().length <= 12"
              },
              "theme": {
                "$k": {
                  ".validate": "newData.isString() && newData.val().length <= 9"
                }
              },
              "preuve": {
                ".validate": "newData.isString() && newData.val().length <= 64"
              }
            }
          },
          "match_data": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid"
            }
          },
          "fini_states": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid",
              ".validate": "newData.isBoolean()"
            }
          },
          "round_wins": {
            "$round": {
              "$uid": {
                ".write": "auth != null && auth.uid === $uid"
              }
            }
          },
          "piege_pret": {
            "$cible": {
              ".write": "auth != null && auth.uid !== $cible && root.child('v7/lobbies/' + $code + '/settings/piege_de/' + auth.uid).exists()",
              ".validate": "newData.hasChildren(['n', 'p'])"
            }
          },
          "piege_essais": {
            "$cible": {
              "$k": {
                ".write": "auth != null && auth.uid === $cible && !data.exists()",
                ".validate": "newData.isString() && newData.val().matches(/^[A-Z]+$/)"
              }
            }
          },
          "piege_verdicts": {
            "$cible": {
              "$k": {
                ".write": "auth != null && auth.uid !== $cible && !data.exists() && root.child('v7/lobbies/' + $code + '/settings/piege_de/' + auth.uid).exists()",
                ".validate": "newData.isString() && newData.val().matches(/^[BMA]+$/)"
              }
            }
          },
          "piege_recap": {
            "$r": {
              "$cible": {
                ".write": "auth != null && auth.uid !== $cible && !data.exists() && root.child('v7/lobbies/' + $code + '/settings/piege_de/' + auth.uid).exists()",
                ".validate": "newData.hasChildren(['de', 'mot'])"
              }
            }
          },
          "status": {
            ".validate": "newData.isString()"
          },
          "spectateurs": {
            "$uid": {
              ".read": "auth != null && auth.uid === $uid",
              ".write": "auth != null && ((auth.uid === $uid && (data.exists() || !newData.exists() || ((data.parent().parent().child('status').val() === 'waiting' || root.child('v7/invitations/' + $uid + '/' + $code).exists()) && (!root.child('v7/secrets/' + $code).exists() || newData.child('preuve').val() === root.child('v7/secrets/' + $code).val())))) || (!newData.exists() && data.child('last_seen').val() < now - 25000))",
              ".validate": "newData.hasChildren(['name'])",
              "name": {
                ".validate": "newData.isString() && newData.val().length <= 30"
              },
              "preuve": {
                ".validate": "newData.isString() && newData.val().length <= 64"
              }
            }
          }
        }
      },
      "demandes": {
        "$code": {
          ".read": "auth != null && root.child('v7/lobbies/' + $code + '/settings/host_id').val() === auth.uid",
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && ((auth.uid === $uid && (!newData.exists() || (root.child('v7/lobbies/' + $code + '/settings').exists() && (data.exists() || (!root.child('v7/secrets/' + $code).exists() || newData.child('preuve').val() === root.child('v7/secrets/' + $code).val()))))) || (!newData.exists() && root.child('v7/lobbies/' + $code + '/settings/host_id').val() === auth.uid))",
            ".validate": "newData.hasChildren(['name', 't'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 30"
            },
            "t": {
              ".validate": "newData.isNumber() && newData.val() <= now + 5000"
            },
            "preuve": {
              ".validate": "newData.isString() && newData.val().length <= 64"
            },
            "$autre": {
              ".validate": false
            }
          }
        }
      },
      "codes_amis": {
        ".read": "auth != null",
        "$c": {
          ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid) || (!newData.exists() && data.val() === auth.uid))",
          ".validate": "$c.matches(/^[A-Z2-9]{6}$/) && newData.isString()"
        }
      },
      "profils": {
        "$uid": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid === $uid",
          "pseudo": {
            ".validate": "newData.isString() && newData.val().length <= 30"
          },
          "code": {
            ".validate": "newData.isString() && newData.val().length <= 8"
          },
          "vu": {
            ".validate": "newData.isNumber() && newData.val() <= now + 5000"
          },
          "salon": {
            ".validate": "newData.isString() && newData.val().length <= 4"
          },
          "cree": {
            ".validate": "newData.isNumber()"
          },
          "$autre": {
            ".validate": false
          }
        }
      },
      "amis": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          "$ami": {
            ".write": "auth != null && (auth.uid === $uid || (auth.uid === $ami && (!newData.exists() || root.child('v7/amis_demandes/' + $ami + '/' + $uid).exists())))",
            ".validate": "newData.val() === true && $uid !== $ami"
          }
        }
      },
      "amis_demandes": {
        "$cible": {
          ".read": "auth != null && auth.uid === $cible",
          "$de": {
            ".write": "auth != null && ((auth.uid === $de && $de !== $cible) || (auth.uid === $cible && !newData.exists()))",
            ".validate": "newData.hasChildren(['pseudo', 't'])",
            "pseudo": {
              ".validate": "newData.isString() && newData.val().length <= 30"
            },
            "t": {
              ".validate": "newData.isNumber() && newData.val() <= now + 5000"
            },
            "$autre": {
              ".validate": false
            }
          }
        }
      },
      "invitations": {
        "$cible": {
          ".read": "auth != null && auth.uid === $cible",
          "$code": {
            ".write": "auth != null && ((auth.uid === $cible && !newData.exists()) || (newData.child('de').val() === auth.uid && root.child('v7/lobbies/' + $code + '/players/' + auth.uid).exists() && root.child('v7/amis/' + $cible + '/' + auth.uid).exists()) || (!newData.exists() && data.child('de').val() === auth.uid))",
            ".validate": "newData.hasChildren(['de', 'pseudo', 't'])",
            "de": {
              ".validate": "newData.isString()"
            },
            "pseudo": {
              ".validate": "newData.isString() && newData.val().length <= 30"
            },
            "t": {
              ".validate": "newData.isNumber() && newData.val() <= now + 5000"
            },
            "$autre": {
              ".validate": false
            }
          }
        }
      },
      "classements": {
        ".read": "auth != null",
        "mdj": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['pseudo', 'meilleure', 'maj'])",
            "pseudo": {
              ".validate": "newData.isString() && newData.val().length <= 30"
            },
            "meilleure": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && (data.exists() ? newData.val() <= data.val() + 1 + (now - data.parent().child('maj').val()) / 86400000 : newData.val() <= 365)"
            },
            "actuelle": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= newData.parent().child('meilleure').val()"
            },
            "maj": {
              ".validate": "newData.isNumber() && newData.val() <= now + 5000"
            },
            "jour": {
              ".validate": "newData.isString() && newData.val().length <= 10"
            },
            "essais": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 8"
            },
            "$autre": {
              ".validate": false
            }
          }
        },
        "marathon": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['pseudo', 'record', 'maj'])",
            "pseudo": {
              ".validate": "newData.isString() && newData.val().length <= 30"
            },
            "record": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 500"
            },
            "maj": {
              ".validate": "newData.isNumber() && newData.val() <= now + 5000"
            },
            "score": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000"
            },
            "$autre": {
              ".validate": false
            }
          }
        }
      }
    }
  }
}
